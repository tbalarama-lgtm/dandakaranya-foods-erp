{
  "name": "win-win",
  "version": "1.0.0",
  "description": "WIN WIN — offline Assembly constituency and local-body election administration for Windows and macOS",
  "main": "./out/main/index.js",
  "author": "WIN WIN",
  "license": "UNLICENSED",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "electron-builder install-app-deps",
    "dev": "electron-vite dev",
    "preview": "electron-vite preview",
    "build": "electron-vite build",
    "rebuild:native": "electron-builder install-app-deps",
    "rebuild:node": "npm rebuild better-sqlite3",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "npm run rebuild:node && vitest run",
    "test:watch": "vitest",
    "dist:win": "npm run typecheck && npm run test && npm run build && electron-builder --win nsis --x64",
    "dist:win:dir": "npm run build && electron-builder --win dir --x64",
    "dist:mac": "npm run typecheck && npm run test && npm run build && electron-builder --mac dmg --arm64 --x64",
    "dist:mac:arm64": "npm run build && electron-builder --mac dmg --arm64",
    "dist:mac:x64": "npm run build && electron-builder --mac dmg --x64",
    "dist:mac:dir": "npm run build && electron-builder --mac dir"
  },
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "exceljs": "^4.4.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.2",
    "typescript": "^5.7.3",
    "vite": "^5.4.14",
    "vitest": "^2.1.9"
  }
}
