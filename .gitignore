# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
/.netlify/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# local SQLite database
/prisma/dev.db
/prisma/dev.db-journal

# uploaded HR resumes (metadata in data/recruitment-resumes.json)
/public/uploads/resumes/*
!/public/uploads/resumes/.gitkeep
/data/recruitment-resumes.json

# uploaded employee photos (metadata in data/hr-employees.json)
/public/uploads/employees/*
!/public/uploads/employees/.gitkeep
/data/hr-employees.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
