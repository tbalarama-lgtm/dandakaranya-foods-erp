model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String
  name           String
  role           UserRole  @default(SALES_EXECUTIVE)
  active         Boolean   @default(true)
  lastLoginAt    DateTime?
  sessionVersion Int       @default(0)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  branchId           String?
  branch             Branch?            @relation(fields: [branchId], references: [id])
  organizationId     String?
  organization       Organization?      @relation(fields: [organizationId], references: [id])
  activityLogs       ActivityLog[]
  auditTrails        AuditTrail[]
  assignedLeads      Lead[]             @relation("LeadAssignee")
  assignedLeadTasks  LeadTask[]         @relation("LeadTaskAssignee")
  leadNotes          LeadNote[]
  leadCommunications LeadCommunication[]
  notifications            Notification[]
  notificationActionLogs   NotificationActionLog[]
  notificationPreferences  NotificationPreference?
  assignedNotifications    Notification[]         @relation("NotificationAssignee")
  salesInvoices      SaleInvoice[]
  salesOrders        SalesOrder[]
  purchases          Purchase[]
  approvedPurchases  Purchase[]         @relation("PurchaseApprover")
  productionLogs     ProductionLog[]
  productionStageEvents ProductionStageEvent[] @relation("ProductionStageOperator")
  productionOperators ProductionOperatorAssignment[] @relation("ProductionOperatorUser")
  productionComplianceAudits ProductionComplianceLog[] @relation("ProductionComplianceAuditor")
  productionAuditLogs ProductionAuditLog[] @relation("ProductionAuditActor")
  expenses           Expense[]
  employee           Employee?
  uploadedDocuments  Document[]             @relation("DocumentUploader")
  approvedDocuments  Document[]             @relation("DocumentApprover")
  documentVersions   DocumentVersion[]
  documentComments   DocumentComment[]
  documentDownloads  DocumentDownloadLog[]
  documentApprovals  DocumentApprovalStep[]
  customerCommunications CustomerCommunication[] @relation("CustomerCommUser")
  customerSupportTickets CustomerSupportTicket[] @relation("CustomerTicketAssignee")
  quotations             Quotation[]
  creditNotes            CreditNote[]
  recurringInvoices      RecurringInvoice[]
  grnsReceived           GoodsReceiptNote[]      @relation("GRNReceiver")
  grnQcHead              GoodsReceiptNote[]      @relation("GRNQcOfficerHead")
  grnInspections         GRNInspection[]         @relation("GRNInspectionOfficer")
  grnEvents              GRNEvent[]              @relation("GRNEventUser")
  grnVendorReturns       GRNVendorReturn[]       @relation("GRNReturnInitiator")
  complianceAudits       ComplianceAuditLog[]    @relation("ComplianceAuditor")
  rfqsCreated            ProcurementRFQ[]        @relation("RFQCreator")
  rfqEvents              RFQEvent[]              @relation("RFQEventUser")
  poEvents               POEvent[]               @relation("POEventUser")
  procurementApprovals   ProcurementApproval[] @relation("ProcurementApprover")
  approvalComments       ApprovalComment[]
  approvalWorkflowEvents ApprovalWorkflowEvent[] @relation("ApprovalWorkflowActor")
  approvalDelegationsFrom ApprovalDelegation[] @relation("ApprovalDelegationFrom")
  approvalDelegationsTo   ApprovalDelegation[] @relation("ApprovalDelegationTo")
  approvalDelegatedSteps  ProcurementApproval[] @relation("ApprovalDelegate")
  budgetApprovals         BudgetApproval[] @relation("BudgetApprover")
  budgetAuditLogs         BudgetAuditLog[] @relation("BudgetAuditActor")
  budgetRevisions         BudgetRevision[] @relation("BudgetRevisionUser")
  approvedBudgets         ProcurementBudget[] @relation("BudgetApprovedBy")
  inventoryAdjustments    InventoryAdjustment[] @relation("InventoryAdjustmentUser")
  inventoryAuditLogs      InventoryAuditLog[] @relation("InventoryAuditActor")
  inventoryReservations   InventoryReservation[] @relation("InventoryReservationUser")
  warehouseTransfers      WarehouseTransfer[] @relation("WarehouseTransferUser")
  warehouseTransfersApproved WarehouseTransfer[] @relation("WarehouseTransferApprover")
  pickPackTasks           PickPackDispatch[] @relation("PickPackUser")
  pickPackApproved        PickPackDispatch[] @relation("PickPackApprover")
  warehouseStaff          WarehouseStaffAssignment[] @relation("WarehouseStaffUser")
  warehouseTasks          WarehouseTask[] @relation("WarehouseTaskUser")
  warehouseAuditLogs      WarehouseAuditLog[] @relation("WarehouseAuditActor")
  batchTraces             BatchWarehouseTrace[] @relation("BatchTraceActor")
  stockMovements          StockMovement[] @relation("StockMovementUser")
}

model ActivityLog {
  id         String         @id @default(cuid())
  userId     String?
  userName   String?
  action     ActivityAction
  entityType String
  entityId   String?
  message    String
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime       @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
  @@index([entityType])
  @@index([action])
}

model CompanyProfile {
  id          Int      @id @default(1)
  name        String   @default("Dandakaranya Foods")
  legalName   String?
  tagline     String?
  address     String?
  phone       String?
  email       String?
  gstin       String?
  logoUrl     String?
  website     String?
  updatedAt   DateTime @updatedAt
}

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

model Customer {
  id                   String              @id @default(cuid())
  name                 String
  company              String?
  email                String?
  phone                String
  gstin                String?
  address              String?
  city                 String?
  state                String?
  pincode              String?
  country              String?
  notes                String?
  segment              CustomerSegment     @default(RETAIL)
  status               CustomerStatus      @default(ACTIVE)
  creditLimit          Decimal?            @db.Decimal(12, 2)
  creditRisk           CustomerCreditRisk  @default(LOW)
  portalEnabled        Boolean             @default(false)
  portalEmail          String?
  packagingPreference  String?
  exportRequirements   String?
  moq                  String?
  distributorTerritory String?
  seasonalNotes        String?
  lastOrderAt          DateTime?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  invoices           SaleInvoice[]
  salesOrders        SalesOrder[]
  quotations         Quotation[]
  creditNotes        CreditNote[]
  recurringInvoices  RecurringInvoice[]
  contacts        CustomerContact[]
  addresses       CustomerAddress[]
  communications  CustomerCommunication[]
  documents       CustomerDocument[]
  supportTickets  CustomerSupportTicket[]

  @@index([phone])
  @@index([name])
  @@index([segment])
  @@index([status])
  @@index([creditRisk])
}

model CustomerContact {
  id         String   @id @default(cuid())
  customerId String
  name       String
  title      String?
  email      String?
  phone      String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model CustomerAddress {
  id         String              @id @default(cuid())
  customerId String
  type       CustomerAddressType
  label      String?
  line1      String
  line2      String?
  city       String?
  state      String?
  pincode    String?
  country    String?
  isDefault  Boolean             @default(false)
  createdAt  DateTime            @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([type])
}

model CustomerCommunication {
  id         String              @id @default(cuid())
  customerId String
  channel    CustomerCommChannel
  message    String
  userId     String?
  createdAt  DateTime            @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  user     User?    @relation("CustomerCommUser", fields: [userId], references: [id])

  @@index([customerId])
  @@index([createdAt])
}

model CustomerDocument {
  id         String          @id @default(cuid())
  customerId String
  docType    CustomerDocType
  name       String
  fileUrl    String?
  notes      String?
  uploadedAt DateTime        @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([docType])
}

model CustomerSupportTicket {
  id           String                @id @default(cuid())
  customerId   String
  ticketNumber String                @unique
  subject      String
  description  String?
  status       SupportTicketStatus   @default(OPEN)
  priority     SupportTicketPriority @default(MEDIUM)
  assigneeId   String?
  createdAt    DateTime              @default(now())
  resolvedAt   DateTime?

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  assignee User?    @relation("CustomerTicketAssignee", fields: [assigneeId], references: [id])

  @@index([customerId])
  @@index([status])
}

model Vendor {
  id                   String               @id @default(cuid())
  code                 String?              @unique
  name                 String
  classification       VendorClassification @default(RAW_MATERIAL)
  status               VendorStatus         @default(ACTIVE)
  contact              String?
  email                String?
  phone                String?
  gstin                String?
  address              String?
  city                 String?
  state                String?
  pincode              String?
  notes                String?
  paymentTerms         VendorPaymentTerms   @default(NET_30)
  customPaymentDays    Int?
  bankName             String?
  bankAccount          String?
  bankIfsc             String?
  fssaiNumber          String?
  qualityScore         Decimal?             @db.Decimal(5, 2)
  deliveryScore        Decimal?             @db.Decimal(5, 2)
  rejectionRate        Decimal?             @db.Decimal(5, 2)
  isFpoPartner         Boolean              @default(false)
  fpoRegion            String?
  seasonalNotes        String?
  moistureLimitPct     Decimal?             @db.Decimal(5, 2)
  preferredWarehouseId String?
  contractRenewalAt    DateTime?
  lastPurchaseAt       DateTime?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  preferredWarehouse Warehouse?            @relation("VendorPreferredWarehouse", fields: [preferredWarehouseId], references: [id])
  purchases          Purchase[]
  contacts           VendorContact[]
  documents          VendorDocument[]
  contracts          VendorContract[]
  qualityRecords     VendorQualityRecord[]
  rfqQuotes          VendorRFQQuote[]
  awardedRfqs        ProcurementRFQ[]      @relation("RFQAwardedVendor")
  aiRecommendedRfqs  ProcurementRFQ[]      @relation("RFQAiRecommended")
  rfqInvitations     RFQVendorInvitation[]
  rfqEvents          RFQEvent[]

  @@index([name])
  @@index([classification])
  @@index([status])
}

model VendorContact {
  id        String   @id @default(cuid())
