model Purchase {
  id               String             @id @default(cuid())
  purchaseNumber   String             @unique
  vendorId         String
  userId           String?
  branchId         String?
  warehouseId      String?
  rfqId            String?
  approvedById     String?
  approvedAt       DateTime?
  approvalStatus   ApprovalStatus     @default(PENDING)
  procurementStage ProcurementStage   @default(DRAFT)
  poStatus         PoLifecycleStatus  @default(DRAFT)
  purchaseDate     DateTime           @default(now())
  expectedDelivery DateTime?
  dueDate          DateTime?
  sentAt           DateTime?
  transporter      String?
  shipmentStatus   ShipmentStatus     @default(PENDING)
  paymentTerms     VendorPaymentTerms @default(NET_30)
  advancePaid      Decimal            @default(0) @db.Decimal(12, 2)
  freightAmount    Decimal            @default(0) @db.Decimal(12, 2)
  budgetAmount     Decimal?           @db.Decimal(14, 2)
  budgetId         String?
  subtotal         Decimal            @db.Decimal(12, 2)
  gstAmount        Decimal            @db.Decimal(12, 2)
  total            Decimal            @db.Decimal(12, 2)
  paymentStatus    PaymentStatus      @default(PENDING)
  billUrl          String?
  billRecordedAt   DateTime?
  notes            String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  vendor         Vendor                @relation(fields: [vendorId], references: [id])
  user           User?                 @relation(fields: [userId], references: [id])
  branch         Branch?               @relation(fields: [branchId], references: [id])
  warehouse      Warehouse?            @relation(fields: [warehouseId], references: [id])
  rfq            ProcurementRFQ?       @relation(fields: [rfqId], references: [id], onDelete: SetNull)
  budget         ProcurementBudget?    @relation(fields: [budgetId], references: [id], onDelete: SetNull)
  approvedBy     User?                 @relation("PurchaseApprover", fields: [approvedById], references: [id])
  items          PurchaseItem[]
  payments       Payment[]
  grn            GoodsReceiptNote?
  qualityRecords VendorQualityRecord[]
  approvals      ProcurementApproval[]
  approvalEvents ApprovalWorkflowEvent[]
  approvalComments ApprovalComment[]
  budgetLinks      BudgetPurchaseLink[]
  events         POEvent[]

  @@index([purchaseDate])
  @@index([approvalStatus])
  @@index([procurementStage])
  @@index([poStatus])
  @@index([vendorId])
  @@index([dueDate])
  @@index([rfqId])
  @@index([expectedDelivery])
  @@index([budgetId])
}

model PurchaseItem {
  id               String         @id @default(cuid())
  purchaseId       String
  productId        String
  quantity         Decimal        @db.Decimal(12, 3)
  unitPrice        Decimal        @db.Decimal(12, 2)
  gstPercent       Decimal        @db.Decimal(5, 2)
  gstAmount        Decimal        @db.Decimal(12, 2)
  freightAmount    Decimal        @default(0) @db.Decimal(12, 2)
  lineTotal        Decimal        @db.Decimal(12, 2)
  tamarindGrade    TamarindGrade?
  moisturePct      Decimal?       @db.Decimal(5, 2)
  acidityPct       Decimal?       @db.Decimal(5, 2)
  seedRatioPct     Decimal?       @db.Decimal(5, 2)
  expectedYieldPct Decimal?       @db.Decimal(5, 2)
  receivedQty      Decimal        @default(0) @db.Decimal(12, 3)
  acceptedQty      Decimal        @default(0) @db.Decimal(12, 3)
  batchNumber      String?
  notes            String?

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])
}

model POEvent {
  id        String      @id @default(cuid())
  purchaseId String
  eventType POEventType
  title     String
  detail    String?
  userId    String?
  createdAt DateTime    @default(now())

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  user     User?    @relation("POEventUser", fields: [userId], references: [id])

  @@index([purchaseId])
  @@index([createdAt])
}

model Payment {
  id          String         @id @default(cuid())
  amount      Decimal        @db.Decimal(12, 2)
  method      String?
  paymentMode PaymentMethod?
  reference   String?
  utr         String?
  reconciled  Boolean        @default(false)
  notes       String?
  paidAt      DateTime       @default(now())
  saleId      String?
  purchaseId  String?

  sale     SaleInvoice? @relation(fields: [saleId], references: [id], onDelete: Cascade)
  purchase Purchase?    @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([reconciled])
}

model CreditNote {
  id              String           @id @default(cuid())
  creditNoteNumber String          @unique
  invoiceId       String
  customerId      String
  userId          String?
  subtotal        Decimal          @db.Decimal(12, 2)
  gstAmount       Decimal          @db.Decimal(12, 2)
  total           Decimal          @db.Decimal(12, 2)
  status          CreditNoteStatus @default(DRAFT)
  reason          String
  items           Json
  issuedAt        DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  invoice  SaleInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  customer Customer    @relation(fields: [customerId], references: [id])
  user     User?       @relation(fields: [userId], references: [id])

  @@index([invoiceId])
  @@index([customerId])
  @@index([status])
}

model RecurringInvoice {
  id            String             @id @default(cuid())
  name          String
  customerId    String
  userId        String?
  frequency     RecurringFrequency @default(MONTHLY)
  nextRunAt     DateTime
  lastRunAt     DateTime?
  active        Boolean            @default(true)
  templateData  Json
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  customer Customer      @relation(fields: [customerId], references: [id])
  user     User?         @relation(fields: [userId], references: [id])
  invoices SaleInvoice[]

  @@index([customerId])
  @@index([nextRunAt])
}

model InvoiceReminderLog {
  id        String   @id @default(cuid())
  invoiceId String
  channel   String
  toAddress String
  status    String   @default("SENT")
  sentAt    DateTime @default(now())

  invoice SaleInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model Lead {
  id                   String        @id @default(cuid())
  company              String
  contactName          String
  email                String?
  phone                String
  stage                LeadStage     @default(NEW)
  priority             LeadPriority  @default(MEDIUM)
  leadSource           LeadSource?
  source               String?
  products             String?
  volume               String?
  value                Decimal?      @db.Decimal(12, 2)
  country              String?
  moq                  String?
  packagingPreference  String?
  shippingTerms        String?
  certifications       String?
  distributorName      String?
  productCategories    String?
  tastingFeedback      String?
  sampleStatus         SampleStatus?
  assigneeId           String?
  followUpAt           DateTime?
  lastContactAt        DateTime?
  convertedAt          DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  assignee       User?               @relation("LeadAssignee", fields: [assigneeId], references: [id])
  notes          LeadNote[]
  productsLinked LeadProduct[]
  communications LeadCommunication[]
  tasks          LeadTask[]
  quotations     Quotation[]
  samples        LeadSample[]
  salesOrders    SalesOrder[]

  @@index([stage])
  @@index([assigneeId])
  @@index([priority])
  @@index([leadSource])
  @@index([followUpAt])
}

model LeadTask {
  id          String         @id @default(cuid())
  leadId      String
  title       String
  dueAt       DateTime?
  reminderAt  DateTime?
  status      LeadTaskStatus @default(PENDING)
  assigneeId  String?
  createdAt   DateTime       @default(now())
  completedAt DateTime?

  lead     Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  assignee User? @relation("LeadTaskAssignee", fields: [assigneeId], references: [id])

  @@index([leadId])
  @@index([dueAt])
  @@index([status])
}

model Quotation {
  id                 String                   @id @default(cuid())
  quoteNumber        String                   @unique
  customerId         String?
  leadId             String?
  userId             String?
  revisionNumber     Int                      @default(1)
  parentQuoteId      String?
  items              Json
  subtotal           Decimal                  @db.Decimal(12, 2)
  discountAmount     Decimal                  @default(0) @db.Decimal(12, 2)
  shippingAmount     Decimal                  @default(0) @db.Decimal(12, 2)
  gstAmount          Decimal                  @db.Decimal(12, 2)
  cgstAmount         Decimal                  @default(0) @db.Decimal(12, 2)
  sgstAmount         Decimal                  @default(0) @db.Decimal(12, 2)
  igstAmount         Decimal                  @default(0) @db.Decimal(12, 2)
  total              Decimal                  @db.Decimal(12, 2)
  status             QuotationStatus          @default(DRAFT)
  taxMode            QuotationTaxMode         @default(DOMESTIC)
  currency           String                   @default("INR")
  exchangeRate       Decimal?                 @db.Decimal(12, 4)
  validUntil         DateTime?
  convertedOrderId   String?
  notes              String?
  internalNotes      String?
  incoterms          String?
  pricingTerms       String?
  moq                String?
  packagingConfig    String?
  containerQty       String?
  shelfLife          String?
  requiresApproval   Boolean                  @default(false)
  sentAt             DateTime?
  approvedAt         DateTime?
  expiredAt          DateTime?
  signedAt           DateTime?
  signatureStatus    QuotationSignatureStatus @default(PENDING)
  signatureName      String?
  templateKey        String                   @default("standard")
  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt

  customer   Customer?            @relation(fields: [customerId], references: [id], onDelete: SetNull)
  lead       Lead?                @relation(fields: [leadId], references: [id], onDelete: SetNull)
  user       User?                @relation(fields: [userId], references: [id])
  parent     Quotation?           @relation("QuoteRevisions", fields: [parentQuoteId], references: [id], onDelete: SetNull)
  revisions  Quotation[]          @relation("QuoteRevisions")
  approvals   QuotationApproval[]
  emailLogs   QuotationEmailLog[]
  salesOrders SalesOrder[]
  invoices    SaleInvoice[]

  @@index([leadId])
  @@index([customerId])
  @@index([status])
  @@index([validUntil])
  @@index([userId])
  @@map("LeadQuotation")
}

model QuotationApproval {
  id           String                  @id @default(cuid())
  quotationId  String
  requestedBy  String?
  approvedBy   String?
  reason       String
  status       QuotationApprovalStatus @default(PENDING)
  createdAt    DateTime                @default(now())
  resolvedAt   DateTime?

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
  @@index([status])
}

model QuotationEmailLog {
  id          String   @id @default(cuid())
  quotationId String
  toEmail     String
  subject     String
  status      String   @default("SENT")
  sentAt      DateTime @default(now())
  openedAt    DateTime?

  quotation Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)

  @@index([quotationId])
}

model LeadSample {
  id          String        @id @default(cuid())
  leadId      String
  productId   String?
  productName String
  quantity    String?
  sentAt      DateTime?
  feedback    String?
  rating      Int?
  status      SampleStatus  @default(REQUESTED)
  createdAt   DateTime      @default(now())

  lead    Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([leadId])
}

model LeadProduct {
  leadId    String
  productId String
  lead      Lead    @relation(fields: [leadId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([leadId, productId])
}

model LeadNote {
  id        String   @id @default(cuid())
  leadId    String
  userId    String?
  content   String
  createdAt DateTime @default(now())

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])
}

model Notification {
  id           String               @id @default(cuid())
  userId       String
  title        String
  message      String
  read         Boolean              @default(false)
  link         String?
  category     NotificationCategory @default(SYSTEM)
  severity     NotificationSeverity @default(INFO)
  status       NotificationStatus   @default(OPEN)
  entityType   String?
  entityId     String?
  ruleKey      String?
  actions      Json?
  metadata     Json?
  escalatedAt  DateTime?
  resolvedAt   DateTime?
  assignedToId String?
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @default(now()) @updatedAt

  user       User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignedTo User?                    @relation("NotificationAssignee", fields: [assignedToId], references: [id], onDelete: SetNull)
  actionLogs NotificationActionLog[]

  @@unique([userId, ruleKey])
  @@index([userId, read])
  @@index([userId, category])
  @@index([userId, severity])
  @@index([userId, status])
  @@index([createdAt])
}

model NotificationActionLog {
  id             String   @id @default(cuid())
  notificationId String
  userId         String
  action         String
  metadata       Json?
  createdAt      DateTime @default(now())

  notification Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([notificationId])
  @@index([userId])
}

model NotificationPreference {
  id           String   @id @default(cuid())
  userId       String   @unique
  email        Boolean  @default(true)
  sms          Boolean  @default(false)
  push         Boolean  @default(true)
  criticalOnly Boolean  @default(false)
  categories   Json?
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ─── Production ───────────────────────────────────────────────────────────────

model Recipe {
  id                  String   @id @default(cuid())
  name                String
  productId           String
  yieldQty            Decimal  @db.Decimal(12, 3)
  yieldUnit           String   @default("kg")
  expectedYieldPct    Decimal  @default(95) @db.Decimal(5, 2)
  standardCycleMin    Int      @default(480)
  stages              Json?
  notes               String?
  active              Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  outputProduct Product             @relation("RecipeOutput", fields: [productId], references: [id])
  lines         RecipeLine[]
  batches       ProductionBatch[]
  workOrders    ProductionWorkOrder[]

  @@index([name])
}

model RecipeLine {
  id        String  @id @default(cuid())
  recipeId  String
  productId String
  quantity  Decimal @db.Decimal(12, 3)
  unit      String  @default("kg")
  scrapPct  Decimal @default(0) @db.Decimal(5, 2)

  recipe  Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])
}

model ProductionMachine {
  id                String                  @id @default(cuid())
  code              String                  @unique
  name              String
  line              String?
  branchId          String?
  status            ProductionMachineStatus @default(ACTIVE)
  capacityKgPerHour Decimal                 @default(100) @db.Decimal(12, 3)
  throughputActual  Decimal                 @default(0) @db.Decimal(12, 3)
  downtimeMinutes   Int                     @default(0)
  lastMaintenanceAt DateTime?
  nextMaintenanceAt DateTime?
  active            Boolean                 @default(true)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @default(now()) @updatedAt

  branch           Branch?                    @relation(fields: [branchId], references: [id])
  batches          ProductionBatch[]
  workOrders       ProductionWorkOrder[]
  scheduleSlots    ProductionScheduleSlot[]
  maintenanceOrders ProductionMaintenanceOrder[]
  oeeSnapshots     ProductionOeeSnapshot[]

  @@index([branchId])
  @@index([status])
}

model ProductionShift {
  id        String   @id @default(cuid())
  branchId  String?
  code      String
  name      String
  startTime String
  endTime   String
  active    Boolean  @default(true)

  branch            Branch?                      @relation(fields: [branchId], references: [id])
  batches           ProductionBatch[]
  scheduleSlots     ProductionScheduleSlot[]
  operatorAssignments ProductionOperatorAssignment[]

  @@unique([branchId, code])
}

model ProductionWorkOrder {
  id           String            @id @default(cuid())
  orderNumber  String            @unique
  recipeId     String
  branchId     String?
  machineId    String?
  batchId      String?           @unique
  status       ProductionStatus  @default(PLANNED)
  priority     WorkOrderPriority @default(MEDIUM)
  plannedQty   Decimal           @db.Decimal(12, 3)
  plannedStart DateTime?
  plannedEnd   DateTime?
  releasedAt   DateTime?
  notes        String?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @default(now()) @updatedAt

  recipe   Recipe             @relation(fields: [recipeId], references: [id])
  branch   Branch?            @relation(fields: [branchId], references: [id])
  machine  ProductionMachine? @relation(fields: [machineId], references: [id])
  batch    ProductionBatch?   @relation(fields: [batchId], references: [id])
  materialRequirements ProductionMaterialRequirement[]

  @@index([status])
  @@index([branchId])
}

model ProductionBatch {
  id              String           @id @default(cuid())
  batchCode       String           @unique
  recipeId        String
  branchId        String?
  machineId       String?
  shiftId         String?
  status          ProductionStatus @default(PLANNED)
  currentStage    ProductionStage?
  plannedQty      Decimal          @db.Decimal(12, 3)
  actualQty       Decimal?         @db.Decimal(12, 3)
  expectedYieldPct Decimal         @default(95) @db.Decimal(5, 2)
  actualYieldPct  Decimal?         @db.Decimal(5, 2)
  wastageQty      Decimal          @default(0) @db.Decimal(12, 3)
  recoveryQty     Decimal          @default(0) @db.Decimal(12, 3)
  materialCost    Decimal          @default(0) @db.Decimal(12, 2)
  laborCost       Decimal          @default(0) @db.Decimal(12, 2)
  machineCost     Decimal          @default(0) @db.Decimal(12, 2)
  utilityCost     Decimal          @default(0) @db.Decimal(12, 2)
  totalCost       Decimal          @default(0) @db.Decimal(12, 2)
  scheduledStart  DateTime?
  scheduledEnd    DateTime?
  releasedAt      DateTime?
  qcAt            DateTime?
  rejectedAt      DateTime?
  startedAt       DateTime?
  completedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @default(now()) @updatedAt

  recipe       Recipe                       @relation(fields: [recipeId], references: [id])
  branch       Branch?                      @relation(fields: [branchId], references: [id])
  machine      ProductionMachine?           @relation(fields: [machineId], references: [id])
  shift        ProductionShift?             @relation(fields: [shiftId], references: [id])
  workOrder    ProductionWorkOrder?
  logs         ProductionLog[]
  stageEvents  ProductionStageEvent[]
  scheduleSlots ProductionScheduleSlot[]
  materialRequirements ProductionMaterialRequirement[]
  utilityReadings ProductionUtilityReading[]
  complianceLogs ProductionComplianceLog[]
  operatorAssignments ProductionOperatorAssignment[]
  alerts       ProductionAlert[]

  @@index([status])
  @@index([branchId])
  @@index([scheduledStart])
}

model ProductionScheduleSlot {
  id             String   @id @default(cuid())
  batchId        String
  machineId      String?
  shiftId        String?
  scheduledStart DateTime
  scheduledEnd   DateTime
  sequenceOrder  Int      @default(0)
  ganttRow       Int      @default(0)
  updatedAt      DateTime @default(now()) @updatedAt

  batch   ProductionBatch    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  machine ProductionMachine? @relation(fields: [machineId], references: [id])
  shift   ProductionShift?   @relation(fields: [shiftId], references: [id])

  @@index([batchId])
  @@index([scheduledStart])
}

model ProductionStageEvent {
  id          String          @id @default(cuid())
  batchId     String
  stage       ProductionStage
  startedAt   DateTime        @default(now())
  completedAt DateTime?
  operatorId  String?
  outputQty   Decimal?        @db.Decimal(12, 3)
  notes       String?

  batch    ProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  operator User?           @relation("ProductionStageOperator", fields: [operatorId], references: [id])

  @@index([batchId])
  @@index([stage])
}

model ProductionMaterialRequirement {
  id            String  @id @default(cuid())
  batchId       String?
  workOrderId   String?
  productId     String
  requiredQty   Decimal @db.Decimal(12, 3)
  allocatedQty  Decimal @default(0) @db.Decimal(12, 3)
  consumedQty   Decimal @default(0) @db.Decimal(12, 3)
  unit          String  @default("kg")
  shortageQty   Decimal @default(0) @db.Decimal(12, 3)
  purchaseId    String?

  batch     ProductionBatch?    @relation(fields: [batchId], references: [id], onDelete: Cascade)
  workOrder ProductionWorkOrder? @relation(fields: [workOrderId], references: [id], onDelete: Cascade)
  product   Product             @relation(fields: [productId], references: [id])

  @@index([batchId])
  @@index([workOrderId])
}

model ProductionLog {
  id        String   @id @default(cuid())
  batchId   String
  userId    String?
  shiftId   String?
  logDate   DateTime @default(now())
  outputQty Decimal  @db.Decimal(12, 3)
  stage     ProductionStage?
  notes     String?

  batch ProductionBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  user  User?           @relation(fields: [userId], references: [id])

  @@index([logDate])
}

model ProductionOperatorAssignment {
  id            String   @id @default(cuid())
  batchId       String?
  shiftId       String?
  userId        String
  role          String   @default("OPERATOR")
  overtimeHours Decimal  @default(0) @db.Decimal(6, 2)
  assignedAt    DateTime @default(now())

  batch ProductionBatch? @relation(fields: [batchId], references: [id], onDelete: Cascade)
  shift ProductionShift? @relation(fields: [shiftId], references: [id])
  user  User             @relation("ProductionOperatorUser", fields: [userId], references: [id])

  @@index([batchId])
  @@index([userId])
}

model ProductionUtilityReading {
  id         String                @id @default(cuid())
  batchId    String?
  branchId   String?
  utilityType ProductionUtilityType
  quantity   Decimal               @db.Decimal(12, 3)
  unit       String
  costAmount Decimal?              @db.Decimal(12, 2)
  recordedAt DateTime              @default(now())

  batch ProductionBatch? @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId])
  @@index([utilityType])
}

model ProductionMaintenanceOrder {
  id          String                    @id @default(cuid())
  machineId   String
  orderNumber String                    @unique
  status      ProductionMaintenanceStatus @default(SCHEDULED)
  isPreventive Boolean                  @default(true)
  scheduledAt DateTime
  completedAt DateTime?
  downtimeMin Int                       @default(0)
  notes       String?
  createdAt   DateTime                  @default(now())

  machine ProductionMachine @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@index([machineId])
  @@index([status])
}

model ProductionComplianceLog {
  id         String             @id @default(cuid())
  batchId    String?
  standard   ComplianceStandard
  checklist  Json
  passed     Boolean
  auditorId  String?
  notes      String?
  auditedAt  DateTime           @default(now())

  batch   ProductionBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  auditor User?            @relation("ProductionComplianceAuditor", fields: [auditorId], references: [id])

  @@index([batchId])
  @@index([standard])
}

model ProductionAuditLog {
  id        String                @id @default(cuid())
  batchId   String?
  action    ProductionAuditAction
  title     String
  detail    String?
  actorId   String?
  metadata  Json?
  createdAt DateTime              @default(now())

  actor User? @relation("ProductionAuditActor", fields: [actorId], references: [id])

  @@index([createdAt])
  @@index([batchId])
}

model ProductionAlert {
  id         String              @id @default(cuid())
  batchId    String?
  branchId   String?
  alertType  ProductionAlertType
  severity   String              @default("WARNING")
  title      String
  message    String?
  resolved   Boolean             @default(false)
  resolvedAt DateTime?
  createdAt  DateTime            @default(now())

  batch ProductionBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)

  @@index([alertType])
  @@index([resolved])
}

model ProductionOeeSnapshot {
  id            String   @id @default(cuid())
  machineId     String
  snapshotDate  DateTime @db.Date
  availability  Decimal  @db.Decimal(5, 2)
  performance   Decimal  @db.Decimal(5, 2)
  quality       Decimal  @db.Decimal(5, 2)
  oee           Decimal  @db.Decimal(5, 2)
  throughputKg  Decimal? @db.Decimal(12, 3)

  machine ProductionMachine @relation(fields: [machineId], references: [id], onDelete: Cascade)

  @@unique([machineId, snapshotDate])
  @@index([machineId])
}

model ProductionForecastPoint {
  id                 String   @id @default(cuid())
  branchId           String?
  periodYear         Int
  periodMonth        Int
  throughputForecast Decimal  @db.Decimal(12, 3)
  bottleneckScore    Decimal? @db.Decimal(5, 2)
  aiOptimizedQty     Decimal? @db.Decimal(12, 3)
  createdAt          DateTime @default(now())

  branch Branch? @relation(fields: [branchId], references: [id])

  @@unique([branchId, periodYear, periodMonth])
  @@index([branchId])
}

// ─── Finance ──────────────────────────────────────────────────────────────────

model Expense {
  id          String          @id @default(cuid())
  branchId    String?
  userId      String?
  category    ExpenseCategory
  amount      Decimal         @db.Decimal(12, 2)
  description String
  expenseDate DateTime        @default(now())
  reference   String?
  createdAt   DateTime        @default(now())

  branch Branch? @relation(fields: [branchId], references: [id])
  user   User?   @relation(fields: [userId], references: [id])

  @@index([expenseDate])
  @@index([category])
}

model LedgerAccount {
  id      String            @id @default(cuid())
  code    String            @unique
  name    String
  type    LedgerAccountType
  active  Boolean           @default(true)
  entries LedgerEntry[]
}

model LedgerEntry {
  id          String   @id @default(cuid())
  accountId   String
  debit       Decimal  @default(0) @db.Decimal(12, 2)
  credit      Decimal  @default(0) @db.Decimal(12, 2)
  description String?
  reference   String?
  entryDate   DateTime @default(now())
  createdAt   DateTime @default(now())

  account LedgerAccount @relation(fields: [accountId], references: [id])

  @@index([entryDate])
  @@index([accountId])
}

// ─── HR ───────────────────────────────────────────────────────────────────────

model Employee {
  id         String   @id @default(cuid())
  userId     String?  @unique
  branchId   String?
  employeeNo String   @unique
  name       String
  email      String?
  phone      String?
  department String?
  designation String?
  salary     Decimal  @default(0) @db.Decimal(12, 2)
  joinedAt   DateTime @default(now())
  active            Boolean  @default(true)
  biometricUserId   String?  @unique
  createdAt         DateTime @default(now())

  user       User?            @relation(fields: [userId], references: [id])
  branch     Branch?          @relation(fields: [branchId], references: [id])
  attendance Attendance[]
  leaves     LeaveRequest[]
  payrolls   PayrollRun[]
  biometricPunches BiometricPunch[]
}

model Attendance {
  id              String           @id @default(cuid())
  employeeId      String
  date            DateTime         @db.Date
  status          AttendanceStatus @default(PRESENT)
  checkIn         DateTime?
  checkOut        DateTime?
  notes           String?
  source          AttendanceSource @default(MANUAL)
  lateMinutes     Int              @default(0)
  overtimeMinutes Int              @default(0)
  deviceId        String?

  employee Employee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  device   BiometricDevice?  @relation(fields: [deviceId], references: [id], onDelete: SetNull)

  @@unique([employeeId, date])
  @@index([date])
}

model BiometricDevice {
  id         String                @id @default(cuid())
  name       String
  provider   BiometricProvider
  ipAddress  String?
  port       Int                   @default(4370)
  serialNo   String?
  branchId   String?
  apiKey     String                @unique @default(cuid())
  status     BiometricDeviceStatus @default(OFFLINE)
  lastSyncAt DateTime?
  lastError  String?
  enabled    Boolean               @default(true)
  createdAt  DateTime              @default(now())
  updatedAt  DateTime              @updatedAt

  branch     Branch?          @relation(fields: [branchId], references: [id], onDelete: SetNull)
  punches    BiometricPunch[]
  attendance Attendance[]

  @@index([enabled])
}

model BiometricPunch {
  id           String          @id @default(cuid())
  deviceId     String
  deviceUserId String
  punchedAt    DateTime
  direction    PunchDirection?
  employeeId   String?
  processed    Boolean         @default(false)
  rawPayload   Json?
  createdAt    DateTime        @default(now())

  device   BiometricDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  employee Employee?       @relation(fields: [employeeId], references: [id], onDelete: SetNull)

  @@index([deviceId, punchedAt])
  @@index([processed, createdAt])
  @@index([deviceUserId])
}

model LeaveRequest {
  id         String      @id @default(cuid())
  employeeId String
  fromDate   DateTime
  toDate     DateTime
  reason     String?
  status     LeaveStatus @default(PENDING)
  createdAt  DateTime    @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@index([status])
}

model PayrollRun {
  id          String   @id @default(cuid())
  employeeId  String
  month       Int
  year        Int
  grossPay    Decimal  @db.Decimal(12, 2)
  deductions  Decimal  @default(0) @db.Decimal(12, 2)
  netPay      Decimal  @db.Decimal(12, 2)
  paidAt      DateTime?
  createdAt   DateTime @default(now())

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, month, year])
}

// ─── CRM communications ───────────────────────────────────────────────────────

model LeadCommunication {
  id        String               @id @default(cuid())
  leadId    String
  userId    String?
  channel   CommunicationChannel
  message   String
  sentAt    DateTime             @default(now())

  lead Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User? @relation(fields: [userId], references: [id])

  @@index([leadId])
}

// ─── Document Vault ───────────────────────────────────────────────────────────

enum DocumentDepartment {
  COMPANY_LEGAL
  HR
  FINANCE
  PRODUCTION
  VENDOR_PROCUREMENT
  SALES_MARKETING
  RD
}

enum DocumentWorkflowStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  ARCHIVED
  REJECTED
}

enum DocumentClassification {
  PUBLIC
  INTERNAL
  CONFIDENTIAL
}

enum DocumentFileType {
  PDF
  DOCX
  XLSX
  PNG
  JPG
  ZIP
  OTHER
}

model DocumentFolder {
  id          String             @id @default(cuid())
  slug        String             @unique
  name        String
  department  DocumentDepartment
  parentId    String?
  path        String
  description String?
  sortOrder   Int                @default(0)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  parent    DocumentFolder?  @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  DocumentFolder[] @relation("FolderTree")
  documents Document[]

  @@index([department])
  @@index([parentId])
}

model Document {
  id               String                   @id @default(cuid())
  title            String
  fileName         String
  fileUrl          String
  mimeType         String
  fileType         DocumentFileType
  sizeBytes        Int
  department       DocumentDepartment
  folderId         String?
  classification   DocumentClassification   @default(INTERNAL)
  workflowStatus   DocumentWorkflowStatus     @default(DRAFT)
  tags             String[]                 @default([])
  description      String?
  expiryDate       DateTime?
  uploadedById     String
  employeeRef      String?
  documentType     String?
  version          Int                      @default(1)
  isStarred        Boolean                  @default(false)
  isShared         Boolean                  @default(false)
  sharedLinkToken  String?                  @unique
  sharedLinkExpiry DateTime?
  ocrText          String?
  aiSummary        String?
  checksum         String?
  internalNotes    String?
  deletedAt        DateTime?
  archivedAt       DateTime?
  approvedById     String?
  approvedAt       DateTime?
  rejectedReason   String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  folder     DocumentFolder?        @relation(fields: [folderId], references: [id], onDelete: SetNull)
  uploadedBy User                   @relation("DocumentUploader", fields: [uploadedById], references: [id])
  approvedBy User?                  @relation("DocumentApprover", fields: [approvedById], references: [id])
  versions   DocumentVersion[]
  comments   DocumentComment[]
  downloads  DocumentDownloadLog[]
  approvals  DocumentApprovalStep[]

  @@index([department])
  @@index([folderId])
  @@index([workflowStatus])
  @@index([expiryDate])
  @@index([deletedAt])
  @@index([archivedAt])
  @@index([uploadedById])
  @@index([createdAt])
}

model DocumentVersion {
  id           String   @id @default(cuid())
  documentId   String
  version      Int
  fileName     String
  fileUrl      String
  mimeType     String
  sizeBytes    Int
  uploadedById String
  changeNotes  String?
  createdAt    DateTime @default(now())

  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  uploadedBy User     @relation(fields: [uploadedById], references: [id])

  @@unique([documentId, version])
}

model DocumentComment {
  id         String   @id @default(cuid())
  documentId String
  userId     String
  body       String
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@index([documentId])
}

model DocumentDownloadLog {
  id         String   @id @default(cuid())
  documentId String
  userId     String
  ipAddress  String?
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@index([documentId])
  @@index([createdAt])
}

model DocumentApprovalStep {
  id         String         @id @default(cuid())
  documentId String
  stepOrder  Int
  approverId String?
  status     ApprovalStatus @default(PENDING)
  comment    String?
  actedAt    DateTime?
  createdAt  DateTime       @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  approver User?    @relation(fields: [approverId], references: [id])

  @@index([documentId])
}

// ─── Audit & integrations ─────────────────────────────────────────────────────

model AuditTrail {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  entityType String
  entityId   String?
  before     Json?
  after      Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([entityType, entityId])
}

model ApiIntegration {
  id        String   @id @default(cuid())
  provider  String
  label     String
  config    Json     @default("{}")
  enabled   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([provider])
}

model BackupLog {
  id        String   @id @default(cuid())
  type      String
  status    String
  fileUrl   String?
  message   String?
  createdAt DateTime @default(now())
}

/// Multi-company foundation — attach organizationId to domain models as you scale.
model Organization {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  legalName String?
  gstin     String?
  address   String?
  phone     String?
  email     String?
  logoUrl   String?
  website   String?
  currency  String   @default("INR")
  timezone  String   @default("Asia/Kolkata")
  isActive  Boolean  @default(true)
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
}
