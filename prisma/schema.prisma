generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // Supabase pooler :6543 (?pgbouncer=true)
  directUrl = env("DIRECT_URL")   // Supabase direct :5432 (migrate / push / seed)
}

